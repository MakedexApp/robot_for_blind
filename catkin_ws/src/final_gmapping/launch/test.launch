<launch>
  <!-- 1. 저장된 맵 로딩 -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(find final_gmapping)/map/0717_4th_floor.yaml" />

  <!-- 2. YDLidar 실행 -->
  <include file="$(find ydlidar_ros_driver)/launch/X4.launch" />

  <!-- 3. Encoder UART + PWM 서버 -->
  <node pkg="final_gmapping" type="jetson_uart_flask.py" name="encoder_uart_listener" output="screen">
    <param name="port" value="/dev/ttyACM0"/>
    <param name="baudrate" value="115200"/>
  </node>

  <!-- 4. Odometry 계산 -->
  <node pkg="final_gmapping" type="odometry_publisher.py" name="odometry_publisher" output="screen" respawn="true"/>


  <!-- 5. IMU 데이터 수신 -->
  <node pkg="final_gmapping" type="imu_uart_publisher.py" name="imu_uart_publisher" output="screen">
    <param name="port" value="/dev/ttyACM1"/>
    <param name="baudrate" value="115200"/>
  </node>

  <!-- 6. EKF (sensor fusion) -->
  <include file="$(find final_gmapping)/launch/ekf.launch" />

  <!-- 7. AMCL 로컬라이제이션 -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_map_topic" value="true"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="global_frame_id" value="map"/>
    <remap from="scan" to="scan"/>
  </node>

  <!-- 8. move_base 실행 -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find final_gmapping)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find final_gmapping)/config/global_costmap_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find final_gmapping)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find final_gmapping)/config/local_costmap_params.yaml" command="load" ns="local_costmap"/>
  </node>

  <!-- 9. RViz Marker로 목적지 위치 라벨 표시 -->
  <node pkg="final_gmapping" type="place_marker.py" name="place_marker" output="screen"/>

  <!-- .5  로봇의 초기 위치 자동 설정 (2D Pose Estimate 대체)
  <node pkg="final_gmapping" type="set_initial_pose.py" name="set_initial_pose" output="screen"/>-->


 <!-- 10. 마커 좌표를 move_base goal로 자동 전송
  <node pkg="final_gmapping" type="auto_goal_sender.py" name="auto_goal_sender" output="screen"/>
-->
  <!-- 11. 마커 좌표로 자율 주행 -->
  <node pkg="final_gmapping" type="cmdvel_to_uart.py" name="cmdvel_to_uart" output="screen"/>

</launch>
