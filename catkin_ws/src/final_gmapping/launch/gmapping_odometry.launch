<launch>
  <!-- 1. 라이다 실행 -->
  <include file="$(find ydlidar_ros_driver)/launch/X4.launch" />

  <!-- 2. STM32에서 엔코더 값 UART 수신 → /encoder/left, /encoder/right -->
  <node pkg="final_gmapping" type="jetson_uart_flask.py" name="encoder_uart_listener" output="screen">
    <param name="port" value="/dev/ttyACM0" />
    <param name="baudrate" value="115200" />
  </node>

  <!-- 3. 오도메트리 계산 및 TF 브로드캐스트 (odom → base_footprint) -->
  <node pkg="final_gmapping" type="odometry_publisher.py" name="odometry_publisher" output="screen" />

  <!-- 4. GMapping 실행 (scan + odom 기반 SLAM) -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_footprint" />
    <param name="odom_frame" value="odom" />
    <param name="map_update_interval" value="1.0" />
    <param name="maxUrange" value="8.0" />
    <param name="particles" value="100" />
    <param name="delta" value="0.05" />
    <param name="linearUpdate" value="0.1" />
    <param name="angularUpdate" value="0.1" />
    <param name="minimumScore" value="100.0" />
    <param name="temporalUpdate" value="3.0" />
  </node>
</launch>
