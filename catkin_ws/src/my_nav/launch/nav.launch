<launch>
  <!-- 2. 위치 추정 (amcl) -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="use_map_topic" value="true" />
    <param name="odom_model_type" value="diff-corrected"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="global_frame_id" value="map"/>
    <remap from="scan" to="scan" />
  </node>

  <!-- 3. 경로 생성 (move_base) -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find my_nav)/param/costmap_common_params.yaml" command="load" />
    <rosparam file="$(find my_nav)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_nav)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find my_nav)/param/base_local_planner_params.yaml" command="load" />
  </node>

  <!-- 4. RViz 자동 실행 -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find my_nav)/rviz/nav_config.rviz"/>
</launch>

