<launch>

  <!-- odom 없이 설정 -->
  <node pkg="tf" type="static_transform_publisher" name="odom_to_base_link" args="0 0 0 0 0 0 odom base_link 100"/>

  <!-- move_base 실행 -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find my_robot_launch)/config/costmap_common.yaml" command="load" />
    <rosparam file="$(find my_robot_launch)/config/global_costmap.yaml" command="load" />
    <rosparam file="$(find my_robot_launch)/config/local_costmap.yaml" command="load" />
    <rosparam file="$(find my_robot_launch)/config/base_local_planner.yaml" command="load" />
    <param name="controller_frequency" value="10.0" />
  </node>
</launch>

