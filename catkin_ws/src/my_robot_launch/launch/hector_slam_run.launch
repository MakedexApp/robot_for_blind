<launch>
  <!-- 1. YDLidar X4 Pro 실행 -->
  <include file="$(find ydlidar_ros_driver)/launch/X4-Pro.launch" />

  <!-- 2. Hector Mapping 실행 -->
  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="base_frame" value="base_footprint" />
    <param name="odom_frame" value="odom" />
    <param name="map_frame" value="map" />
    <param name="pub_map_odom_transform" value="true" />
    <param name="map_pub_period" value="0.05" />
  </node>

  <!-- 3. base_footprint → laser_frame -->
  <node pkg="tf" type="static_transform_publisher" name="laser_to_base" 
        args="0 0 0 0 0 0 base_footprint laser_frame 100" />

  <!-- 4. odom → base_footprint (오도메트리 없음 대체용 고정변환) -->
  <node pkg="tf" type="static_transform_publisher" name="odom_to_base"
      args="0.0 0.0 0 0 0 0 odom base_footprint 100" />
</launch>

